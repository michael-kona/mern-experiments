<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=t_name%></title>
</head>
<body>
    <h2>Welcome to <%=t_name%></h2>
     Multiplication Table for <%=n%> is as follows:<br>
     <% 
     for(let i=1;i<=10;i++)
        {
      %>
            <p style="color:red"><%=i%>X<%=n%>=<%=i*n%></p>
            <%  } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
</head>
<body>
    <form action="/login" method="get">
        <label for="txt_uname">Enter User Name:</label>
        <input type="text" id="txt_uname" name="txt_uname"/><br>
        <label for="txt_upwd">Enter User Password:</label>
        <input type="text" id="txt_upwd" name="txt_upwd"/><br>
        <input type="submit" value="Login"/>
    </form>
</body>
</html>